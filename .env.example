SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sua_anon_key
SUPABASE_SERVICE_KEY=sua_service_role_key

# Número do WhatsApp da loja (com DDI, sem +)
LOJA_WHATSAPP=5534984148067

# Nome da loja
LOJA_NOME=Fluxo Outlet

# Webhook secret (para validar chamadas do provider)
WEBHOOK_SECRET=seu_secret_aqui

PORT=3000

# ── Horário de atendimento ────────────────────────────────────────────────────
# Formato HH:MM | Dias: 0=Dom, 1=Seg ... 6=Sáb
HORARIO_INICIO=09:00
HORARIO_FIM=18:00
DIAS_UTEIS=1,2,3,4,5,6
TIMEZONE=America/Sao_Paulo
# Defina como "true" para desabilitar a verificação de horário (ex: durante testes)
IGNORAR_HORARIO=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Máximo de mensagens por minuto por telefone
RATE_LIMIT_PER_MIN=15

# ── Session timeout ───────────────────────────────────────────────────────────
# Minutos de inatividade antes de reiniciar o fluxo
SESSION_TIMEOUT_MINUTES=60

# ── Typing delay (webhook WhatsApp real) ─────────────────────────────────────
# Delay base em ms antes de enviar resposta (simula digitação)
TYPING_DELAY_MS=800

# ── InventoryBridge — catálogo do site (READ-ONLY) ───────────────────────────
# Supabase do SITE (não do bot). Usar a anon key (somente leitura).
SITE_SUPABASE_URL=https://SEU_SITE.supabase.co
SITE_SUPABASE_ANON_KEY=sua_anon_key_do_site

# URL base do site (para montar links dos produtos)
SITE_URL=https://www.fluxooutlet.com.br

# ── Integração de compras do site → CRM (Fase A) ─────────────────────────────
# store_id da loja no CRM que recebe as vendas do site (que não têm store_id).
SITE_STORE_ID=
# Segredo do cron — protege /api/integrations/site-purchases/sync e /api/brain/cron.
CRON_SECRET=

# ── IA Generativa ────────────────────────────────────────────────────────────
# Provider "gemini" (Google) — multimodal completo na mesma chave:
#   AI_ASSIST_PROVIDER=gemini | AI_ASSIST_KEY=chave google | AI_ASSIST_MODEL=gemini-2.5-flash
# Provider "anthropic" (Claude) — cérebro Claude Haiku (agente + visão).
# Chave em console.anthropic.com (créditos pré-pagos via cartão/Stripe):
#   AI_ASSIST_PROVIDER=anthropic | AI_ASSIST_KEY=sk-ant-... | AI_ASSIST_MODEL=claude-haiku-4-5
AI_ASSIST_PROVIDER=gemini
AI_ASSIST_KEY=sua_api_key_aqui
AI_ASSIST_MODEL=gemini-2.5-flash
# Gemini: modelo usado automaticamente quando o principal falha (429/erro)
AI_ASSIST_MODEL_FALLBACK=gemini-2.0-flash
# Só com provider anthropic: chave Gemini separada pra TRANSCRIÇÃO DE ÁUDIO
# (Claude não transcreve áudio; free tier do Gemini aguenta esse volume)
GEMINI_KEY=

# ── Baileys (WhatsApp direto via Render) ─────────────────────────────────────
# Habilita o socket WhatsApp no servidor (false em Vercel/serverless)
ENABLE_BAILEYS=false
# UUID da loja principal — necessário para boot automático do Baileys
STORE_ID=
# Telefone do operador para alertas de queda/reconexão (só dígitos, ex: 5534999999999)
OPERATOR_PHONE=
# URL pública do servidor Render — usada para self-ping keep-alive a cada 10 min
RENDER_EXTERNAL_URL=https://bot-fluxo.onrender.com

# ── Auto-resposta no WhatsApp real (OPT-IN — desligado por padrão) ───────────
# true = o bot responde sozinho no WhatsApp conectado via Baileys.
# Mesmo ligado, o engine respeita bot_ativo (painel), humano_ativo, opt-out e
# horário comercial. Mensagens picadas são agrupadas por 5s antes de responder.
# Áudios recebidos são transcritos via Gemini quando a IA está configurada.
BOT_AUTO_REPLY=false

# ── Follow-up automático (OPT-IN — desligado por padrão) ─────────────────────
# true = leads com interesse e conversa parada (45min–24h) recebem 1 retomada.
# Exige BOT_AUTO_REPLY=true e Baileys conectado. Máx 5 envios a cada 5 min.
FOLLOWUP_ATIVO=false
FOLLOWUP_MIN_IDLE_MINUTES=45
