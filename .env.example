SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sua_anon_key
SUPABASE_SERVICE_KEY=sua_service_role_key

# Número do WhatsApp da loja (com DDI, sem +)
LOJA_WHATSAPP=5534984148067

# Nome da loja
LOJA_NOME=Fluxo Outlet

# Webhook secret (para validar chamadas do provider)
WEBHOOK_SECRET=seu_secret_aqui

PORT=3000

# ── Horário de atendimento ────────────────────────────────────────────────────
# Formato HH:MM | Dias: 0=Dom, 1=Seg ... 6=Sáb
HORARIO_INICIO=09:00
HORARIO_FIM=18:00
DIAS_UTEIS=1,2,3,4,5,6
TIMEZONE=America/Sao_Paulo
# Defina como "true" para desabilitar a verificação de horário (ex: durante testes)
IGNORAR_HORARIO=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Máximo de mensagens por minuto por telefone
RATE_LIMIT_PER_MIN=15

# ── Session timeout ───────────────────────────────────────────────────────────
# Minutos de inatividade antes de reiniciar o fluxo
SESSION_TIMEOUT_MINUTES=60

# ── Typing delay (webhook WhatsApp real) ─────────────────────────────────────
# Delay base em ms antes de enviar resposta (simula digitação)
TYPING_DELAY_MS=800

# ── InventoryBridge — catálogo do site (READ-ONLY) ───────────────────────────
# Supabase do SITE (não do bot). Usar a anon key (somente leitura).
SITE_SUPABASE_URL=https://SEU_SITE.supabase.co
SITE_SUPABASE_ANON_KEY=sua_anon_key_do_site

# URL base do site (para montar links dos produtos)
SITE_URL=https://www.fluxooutlet.com.br

# ── IA Generativa (Google Gemini) — P11 Lead Intelligence ───────────────────
AI_ASSIST_PROVIDER=gemini
AI_ASSIST_KEY=sua_google_generative_ai_api_key_aqui
AI_ASSIST_MODEL=gemini-1.5-flash

# ── Baileys (WhatsApp direto via Render) ─────────────────────────────────────
# Habilita o socket WhatsApp no servidor (false em Vercel/serverless)
ENABLE_BAILEYS=false
# UUID da loja principal — necessário para boot automático do Baileys
STORE_ID=
# Telefone do operador para alertas de queda/reconexão (só dígitos, ex: 5534999999999)
OPERATOR_PHONE=
# URL pública do servidor Render — usada para self-ping keep-alive a cada 10 min
RENDER_EXTERNAL_URL=https://bot-fluxo.onrender.com
